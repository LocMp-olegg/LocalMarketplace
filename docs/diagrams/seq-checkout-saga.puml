@startuml seq-checkout-saga
title <size:16><b>Sequence: Оформление заказа</b></size>\n<color:#555>Сага резервирования остатков (Checkout → StockReserve → Confirm/Cancel)</color>

skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam defaultFontSize 14
skinparam roundcorner 8
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

skinparam participant {
    BackgroundColor White
    BorderColor #455A64
    FontColor #1C2833
}
skinparam actor {
    BackgroundColor #E8F5E9
    BorderColor #2E7D32
    FontColor #1B5E20
}
skinparam queue {
    BackgroundColor #F3E5F5
    BorderColor #6A1B9A
}
skinparam database {
    BackgroundColor #EDE7F6
    BorderColor #6A1B9A
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #FBC02D
    FontColor #4E342E
    BorderThickness 1.2
    roundcorner 6
}
skinparam sequence {
    ArrowColor #2C3E50
    ArrowThickness 1.4
    LifeLineBorderColor #607D8B
    LifeLineBackgroundColor #CFD8DC
    BoxBorderColor #B0BEC5
    BoxBackgroundColor transparent
    DividerBackgroundColor #ECEFF1
    DividerBorderColor #90A4AE
    GroupBorderColor #78909C
    GroupBackgroundColor transparent
    GroupHeaderFontColor #263238
    GroupHeaderFontSize 12
}

actor       "Покупатель"         as Buyer
participant "API Gateway\n:5000" as GW       #ECEFF1
participant "OrderService\n:5003" as OS      #EDE7F6
participant "CatalogService\n:5002" as CS    #E8F5E9
database    "PostgreSQL\norders"  as PGOS    #EDE7F6
queue       "RabbitMQ"            as MQ      #F3E5F5
database    "PostgreSQL\ncatalog" as PGCS    #E8F5E9
participant "NotificationService\n:5005" as NS #E0F7FA
participant "AnalyticsService\n:5006" as AS  #FFF3E0

' ══════════════════════════════════════════════════════════════
== Добавление товара в корзину ==
' ══════════════════════════════════════════════════════════════

Buyer -> GW     : POST /api/orders/carts/items\n{productId, quantity}
activate GW
GW    -> OS     : Маршрутизация (HTTP + JWT)
deactivate GW
activate OS
OS    -> CS     : GET /api/products/{productId}\n(проверка наличия и остатка)
activate CS
CS   --> OS     : ProductDto
deactivate CS
OS    -> PGOS   : SELECT Carts WHERE UserId = ... AND ExpiresAt > now\nINSERT Cart (если нет) ExpiresAt = now + 24ч\nINSERT/UPDATE CartItem (снепшот: name, price, sellerId)
PGOS --> OS     : Cart + CartItems
OS   --> Buyer  : 200 CartDto
deactivate OS

note over PGOS
  Корзина хранится в PostgreSQL (schema: orders):
  Таблица Carts: UserId, ExpiresAt (TTL 24ч)
  Таблица CartItems: снепшот ProductName, Price,
  SellerId, SellerName, ShopId, ShopName
  Фоновый сервис CartCleanupBackgroundService
  удаляет истёкшие корзины каждый час.
end note

' ══════════════════════════════════════════════════════════════
== Checkout — создание заказа ==
' ══════════════════════════════════════════════════════════════

Buyer -> GW   : POST /api/orders/checkout\n{cartId, deliveryType, address?}
activate GW
GW    -> OS   : Маршрутизация (HTTP + JWT)
deactivate GW
activate OS

OS -> PGOS    : SELECT Carts + CartItems WHERE UserId = ...
PGOS --> OS   : Cart + CartItems (снепшоты)

loop для каждого уникального продавца в корзине

    OS -> CS  : GET /api/products/{productId}\n(актуальный снепшот: name, price, sellerId)
    activate CS
    CS --> OS : ProductDto
    deactivate CS

    OS -> CS  : GET /api/shops/{shopId}
    activate CS
    CS --> OS : ShopDto
    deactivate CS

    OS -> PGOS : INSERT Order{Status=Pending}\n+ OrderItems (снепшоты)\n+ OrderStatusHistory{null→Pending}
end

OS -> PGOS    : DELETE CartItems (выбранные позиции)

loop для каждого товара (синхронное HTTP-резервирование)
    OS -> CS  : POST /api/products/{productId}/reserve\n{quantity, orderId}  [X-Internal-Key]
    activate CS
    CS -> PGCS : SELECT StockQuantity WHERE Id = productId

    alt [Достаточно_остатков]
        CS -> PGCS : UPDATE Products SET StockQuantity -= qty\nINSERT StockHistory{OrderReserved, -qty}
        CS -> MQ   : <color:#6A1B9A>StockReservedEvent</color>\n{productId, orderId, reservedQty}
        CS --> OS  : 200 OK
    else [Недостаточно_остатков]
        CS -> MQ   : <color:#6A1B9A>StockReservationFailedEvent</color>\n{productId, orderId, reason="Insufficient stock"}
        CS --> OS  : 409 Conflict
        OS -> OS   : ReleaseStockAsync для уже зарезервированных (компенсация)
    end
    deactivate CS
end

OS -> MQ      : <color:#6A1B9A>OrderPlacedEvent</color>\n{orderId, buyerId, sellerId, total}
OS --> Buyer  : 201 CheckoutResultDto{[orderId, ...]}
deactivate OS

' ══════════════════════════════════════════════════════════════
== OrderService получает результат резервирования ==
' ══════════════════════════════════════════════════════════════

group StockReservedEvent (успешный путь)
    MQ -> OS     : <color:#B71C1C>consume StockReservedEvent</color>
    activate OS
    OS -> PGOS   : UPDATE Orders SET Status = Confirmed\nINSERT OrderStatusHistory{Pending→Confirmed}
    OS -> MQ     : <color:#6A1B9A>OrderStatusChangedEvent</color>\n{Pending→Confirmed}
    deactivate OS
end

group StockReservationFailedEvent (отказ)
    MQ -> OS     : <color:#B71C1C>consume StockReservationFailedEvent</color>
    activate OS
    OS -> PGOS   : UPDATE Orders SET Status = Cancelled\nINSERT OrderStatusHistory{Pending→Cancelled}
    OS -> MQ     : <color:#6A1B9A>OrderStatusChangedEvent</color>\n{Pending→Cancelled}
    deactivate OS
end

' ══════════════════════════════════════════════════════════════
== Уведомления и аналитика ==
' ══════════════════════════════════════════════════════════════

par Параллельная обработка событий
    MQ -> NS : <color:#B71C1C>OrderPlacedEvent</color>\n→ уведомление продавцу\n«Новый заказ на сумму X ₽»
    MQ -> NS : <color:#B71C1C>OrderStatusChangedEvent</color>\n→ уведомление покупателю\n(Confirmed: «Заказ подтверждён»\nCancelled: «Заказ отменён»)
    MQ -> AS : <color:#B71C1C>OrderPlacedEvent</color>\n→ PlatformDailySummary.OrdersPlaced++\n→ GeographicActivity
end

@enduml
